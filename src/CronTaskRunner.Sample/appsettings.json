{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "MssqlDeals": "Server=mssql-host;Database=CoreBanking;User Id=svc_reconciliation;Password=__set_via_user-secrets_or_env__;TrustServerCertificate=True",
    "OracleDeals": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-host)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=SVOD)));User Id=svc_reconciliation;Password=__set_via_user-secrets_or_env__"
  },
  "ScheduledEvents": {
    "Events": [
      {
        "Name": "ExchangeRateCheck-MorningAndEvening",
        "Enabled": true,
        "TaskKey": "ExchangeRateCheck",
        "CronExpressions": [
          "15 8 * * *",
          "34 9 * * *",
          "23 23 * * *"
        ],
        "Options": {
          "To": [ "alerts@company.com" ],
          "ThresholdPercent": 1.5
        }
      },
      {
        "Name": "DealsReconciliation-Nightly",
        "Enabled": true,
        "TaskKey": "DealsReconciliation",
        "CronExpressions": [
          "0 3 * * *"
        ],
        "Options": {
          "To": [ "reconciliation-alerts@company.com", "risk-team@company.com" ],
          "LookbackDays": 1
        }
      }
    ]
  },
  "DealsReconciliation": {
    "UseInMemorySources": false
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.company.local",
    "Port": 587,
    "EnableSsl": true,
    "User": "reconciliation@company.local",
    "Password": "",
    "From": "reconciliation@company.local"
  }
}
